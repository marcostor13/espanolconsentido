# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/consentido

# PayPal (link PayPal.me) - solo para construir el enlace en el frontend
VITE_PAYPAL_ME_USERNAME=tu_usuario_paypal

# WhatsApp (botón flotante) - número en formato internacional E.164 sin "+" ni espacios (ej. 51987654321)
VITE_WHATSAPP_NUMBER=

# Admin (para confirmar pagos - legacy, se mantiene por compatibilidad)
ADMIN_TOKEN=tu_token_secreto

# Auth (plataforma con login JWT)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Google Calendar
GOOGLE_CALENDAR_ID=xxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email (Resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@espanolconsentido.com
ADMIN_NOTIFY_EMAIL=marcostor13@gmail.com

# URL pública del sitio (se usa en el enlace de login del correo de bienvenida)
SITE_URL=https://espanolconsentido.com

# S3 (subida de material de clase: PDF, video, audio, imágenes)
# 1. Crea un bucket en AWS S3 (o compatible: Cloudflare R2, Backblaze B2, etc.)
# 2. Crea un usuario/API key con permiso s3:PutObject sobre ese bucket
# 3. Configura el bucket con acceso de lectura pública para el prefijo "materials/"
#    (o usa CloudFront/S3_PUBLIC_URL_BASE si prefieres servirlo por un dominio propio)
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=espanolconsentido-materiales
# Opcional: dominio propio o de CloudFront delante del bucket
S3_PUBLIC_URL_BASE=

# Stripe (pago con tarjeta, checkout real con confirmación automática)
# 1. Crea una cuenta en https://dashboard.stripe.com (modo test para probar)
# 2. Copia la clave secreta (Developers > API keys > Secret key)
# 3. Crea un webhook (Developers > Webhooks) apuntando a:
#    https://tu-dominio.com/api/stripe-webhook
#    con el evento "checkout.session.completed", y copia su "Signing secret"
STRIPE_SECRET_KEY=<tu-clave-secreta-de-stripe>
STRIPE_WEBHOOK_SECRET=<tu-signing-secret-del-webhook>

# Wise: no ofrece una API de checkout self-service para negocios pequeños,
# así que se integra como enlace de pago manual (igual que PayPal.me). Los
# enlaces por paquete se configuran desde /admin/configuraciones, no aquí.
